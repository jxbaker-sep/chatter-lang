# Chatter standard library: queue
#
# Mutable FIFO queues backed by generic mutable linked lists.
#
# Invariants:
# - front points at the first Node when length is greater than 0.
# - back points at the final Node when length is greater than 0.
# - length is the number of queued values.
# - back's next is none when the queue is non-empty.

export mutable struct QueueNode over T
    T value
    optional QueueNode of T next
end struct

export mutable struct Queue over T
    QueueNode of T front
    QueueNode of T back
    number length
end struct

# new_queue_with: return a fresh singleton queue containing first.
# O(1). Empty construction is intentionally left to typed contexts in v1.
export function new_queue_with over T takes T first returns Queue of T is
    constant node is make QueueNode with value first, next none
    return make Queue with front node, back node, length 1
end function

# enqueue: add value to the back of the queue in place.
# O(1) thanks to the cached back pointer.
export function enqueue over T takes Queue of T queue with T value is
    constant node is make QueueNode with value value, next none
    if length of queue is 0
        change front of queue to node
        change back of queue to node
    else
        constant old_back is back of queue
        change next of old_back to node
        change back of queue to node
    end if
    add 1 to length of queue
end function

# dequeue: remove and return the front value.
# O(1). Runtime error if the queue is empty.
export function dequeue over T takes Queue of T queue returns T is
    expect length of queue is greater than 0, "cannot dequeue from empty queue"
    constant front_node is front of queue
    constant result is value of front_node
    if length of queue is 1
        change length of queue to 0
    else
        constant next_node is next of front_node
        if next_node is none
            fail "queue invariant broken"
        end if
        change front of queue to next_node
        subtract 1 from length of queue
    end if
    return result
end function

# peek: return the front value without removing it.
# O(1). Runtime error if the queue is empty.
export function peek over T takes Queue of T queue returns T is
    expect length of queue is greater than 0, "cannot peek empty queue"
    constant front_node is front of queue
    return value of front_node
end function

# size_of: return the cached number of queued values.
# O(1).
export function size_of over T takes Queue of T queue returns number is
    return length of queue
end function

# is_empty: return true when the queue has no values.
# O(1).
export function is_empty over T takes Queue of T queue returns boolean is
    return length of queue is 0
end function

# clear: reset the queue to the empty state.
# O(1). A future enqueue overwrites the cached front and back pointers.
export function clear over T takes Queue of T queue is
    change length of queue to 0
end function
