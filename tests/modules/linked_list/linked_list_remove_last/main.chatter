use make_linked_list_with, append, remove_last, size_of, to_list, head, tail from "std:linked_list"
constant ll is the result of make_linked_list_with 1
append ll with 2
append ll with 3
remove_last ll
size_of ll
say it
to_list ll
say it
constant h is the result of head ll
constant t is the result of tail ll
if h is not none
    say value of h
end if
if t is not none
    say value of t
end if
