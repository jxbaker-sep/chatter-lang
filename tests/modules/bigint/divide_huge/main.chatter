use bigint_from_string, bigint_divide, bigint_to_string from "std:bigint"

# 1,000,000,000,000,000,000,000,000 / 7 = 142,857,142,857,142,857,142,857
# (well beyond JS safe-integer range, so this exercises the full long-division loop)
bigint_from_string "1000000000000000000000000"
constant a is it
bigint_from_string "7"
constant b is it
bigint_divide a by b
bigint_to_string it
say it
