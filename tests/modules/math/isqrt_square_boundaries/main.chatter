use isqrt from "std:math"
repeat with r from 2 to 200
  constant below is the result of isqrt r * r - 1
  constant above is the result of isqrt (r + 1) * (r + 1) - 1
  expect below is r - 1, "isqrt of " & r * r - 1 & " gave " & below
  expect above is r, "isqrt of " & (r + 1) * (r + 1) - 1 & " gave " & above
end repeat
say "ok"
