# A guard before a loop narrows `cur`, but the loop reassigns it, so the
# loop condition must re-check it (and may compare it with none).
mutable struct Cell
    number value
    optional Cell next
end struct

function walk takes optional Cell start is
    variable cur is start
    if cur is none
        return
    end if
    repeat while cur is not none
        say value of cur
        change cur to next of cur
    end repeat
end function

constant c3 is make Cell with value 3, next none
constant c2 is make Cell with value 2, next c3
constant c1 is make Cell with value 1, next c2
walk c1
